{
  "version": "1.0.0",
  "created_at": "2026-06-29",
  "description": "Catálogo de braços para experimento MAB adaptativo.",
  "dataset_reference": {
    "source": "UCI Bank-Marketing Dataset",
    "n": 41188,
    "base_conversion_rate_global": 0.113
  },
  "segments": {
    "previous_converter": {
      "rule": "poutcome == 'success'",
      "conversion_rate": 0.651,
      "global_multiplier": 5.78,
      "note": "Cliente que já converteu em campanha anterior."
    },
    "high_season": {
      "rule": "month in ['mar','sep','oct','dec']",
      "conversion_rate": 0.465,
      "global_multiplier": 4.12,
      "note": "Meses com taxa 4x acima da média. Feature contextual/temporal."
    },
    "student_digital": {
      "rule": "job == 'student' AND contact == 'cellular'",
      "conversion_rate": 0.364,
      "global_multiplier": 3.23,
      "note": "Interação forte: student+cellular=36.4% vs student+telephone=15.2%."
    },
    "retired": {
      "rule": "job == 'retired'",
      "conversion_rate": 0.253,
      "global_multiplier": 2.24,
      "note": "Alta propensão geral. Aposentado não é público de previdência."
    },
    "admin_worker": {
      "rule": "job == 'admin.'",
      "conversion_rate": 0.13,
      "global_multiplier": 1.15,
      "note": "Menor taxa individual mas maior volume (~10k clientes)."
    },
    "university_educated": {
      "rule": "education == 'university.degree'",
      "conversion_rate": 0.137,
      "global_multiplier": 1.21,
      "note": "Mais receptivo a produtos complexos: PGBL, LCI/LCA com benefício fiscal."
    },
    "digital_channel": {
      "rule": "contact == 'cellular'",
      "conversion_rate": 0.147,
      "global_multiplier": 1.3,
      "note": "14.7% vs 5.2% telephone. Aumenta relevância de braços via app/push."
    },
    "debt_free": {
      "rule": "housing == 'no' AND loan == 'no' AND default == 'no'",
      "conversion_rate": null,
      "global_multiplier": null,
      "note": "Sem compromissos financeiros ativos. Maior capacidade de alocar capital."
    },
    "low_engagement": {
      "rule": "previous == 0 AND pdays == 999",
      "conversion_rate": null,
      "global_multiplier": null,
      "note": "Nunca foi abordado em campanhas anteriores. Abordagem inicial deve ser suave."
    },
    "student_saver": {
      "rule": "job == 'student'",
      "conversion_rate": 0.314,
      "global_multiplier": 2.78,
      "note": "Versão mais ampla do student_digital (todos os canais)."
    }
  },
